# ===========================================
# Integrate Health MVP - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===========================================
# Application Settings
# ===========================================
ENVIRONMENT=development
DEBUG=true

# Security (generate with: openssl rand -hex 32)
APP_SECRET_KEY=your-secret-key-min-32-chars-change-in-prod
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_REFRESH_SECRET_KEY=your-refresh-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8
JWT_REFRESH_EXPIRATION_DAYS=7

# ===========================================
# Database
# ===========================================
# Local Docker development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/integrate_health

# AWS RDS (use this format for production)
# DATABASE_URL=postgresql+asyncpg://username:password@rds-endpoint:5432/integrate_health

# PostgreSQL container settings (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=integrate_health

# ===========================================
# Storage Mode
# ===========================================
# Options: "local" or "s3"
STORAGE_MODE=local

# Local storage directory (when STORAGE_MODE=local)
UPLOAD_DIR=uploads

# ===========================================
# AWS Configuration (required for production)
# ===========================================
AWS_REGION=us-east-1

# S3 bucket for audio storage (required when STORAGE_MODE=s3)
S3_BUCKET_NAME=

# S3 prefix for audio files
S3_AUDIO_PREFIX=audio/

# Note generation jobs. Empty uses the local BackgroundTasks fallback.
SQS_QUEUE_URL=

# ===========================================
# Email (AWS SES)
# ===========================================
# Sender address — must be a verified identity in AWS SES
# See: AWS Console → SES → Verified identities
SES_FROM_EMAIL=noreply@integratehealth.ai

# Base URL for password reset links in emails
FRONTEND_URL=https://app.integratehealth.ai

# Public backend URL used to construct WebSocket URLs
BACKEND_URL=http://localhost:8000

# ===========================================
# Deprecated Whisper Service Compatibility
# ===========================================
# Local development (if running Whisper locally)
WHISPER_SERVICE_URL=http://localhost:8080

# Timeout for transcription requests (seconds)
WHISPER_TIMEOUT_SECONDS=300

# ===========================================
# AWS Bedrock (LLM for Note Generation)
# ===========================================
# AWS credentials are resolved through the standard boto3 credential chain.
# Prefer an IAM role in production; never commit static credentials.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Generation parameters
BEDROCK_MAX_TOKENS=16384
BEDROCK_TEMPERATURE=0.3

# Experimental SOAP generation strategy:
#   default    — single Sonnet call (current production behaviour)
#   fast_model — single call with a faster Haiku-class model
#   parallel   — 4 concurrent section calls + patient summary, merged
#   compact    — single Sonnet call with a leaner prompt
SOAP_GENERATION_STRATEGY=default

# Model for the "fast_model" strategy
BEDROCK_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20250929-v1:0

# ===========================================
# Transcription
# ===========================================
# Deepgram is the primary live and prerecorded transcription provider.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2-medical
DEEPGRAM_LANGUAGE=en-US
TRANSCRIPTION_PROVIDER=deepgram

# Legacy direct Anthropic compatibility. Active note generation uses Bedrock.
ANTHROPIC_API_KEY=

# ===========================================
# File Upload Settings
# ===========================================
MAX_AUDIO_SIZE_MB=100
ALLOWED_AUDIO_FORMATS=wav,mp3,m4a,webm,ogg
