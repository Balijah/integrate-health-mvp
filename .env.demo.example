# Copy to .env.demo. This file is for the isolated local synthetic demo only.
DEMO_USER_NAME=Dr. Demo Provider
DEMO_USER_EMAIL=demo.provider@example.com
DEMO_USER_PASSWORD=replace-with-a-local-password-of-12-or-more-characters

# Use unique local-only secrets. Do not reuse production credentials.
APP_SECRET_KEY=replace-with-a-local-demo-secret-of-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-local-demo-jwt-secret-of-at-least-32-characters
JWT_REFRESH_SECRET_KEY=replace-with-a-local-demo-refresh-secret-of-at-least-32-characters

# Alternate loopback-only ports avoid collisions with the normal local stack.
DEMO_FRONTEND_PORT=3001
DEMO_BACKEND_PORT=8001
DEMO_DB_PORT=5433
